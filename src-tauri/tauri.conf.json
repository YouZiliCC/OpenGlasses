{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OpenGlasses",
  "version": "0.1.0",
  "identifier": "io.github.youzilicc.openglasses",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; connect-src 'self' ipc: http://ipc.localhost ws://localhost:1420; img-src 'self' data: blob: http://ogframe.localhost http://ogtheme.localhost; style-src 'self' 'unsafe-inline' http://ogtheme.localhost; font-src 'self' data: http://ogtheme.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    },
    "resources": {
      "../themes/": "themes/"
    }
  }
}
